# =====================================================================
# Mobile (Expo) — biến môi trường
# =====================================================================
# Chỉ biến có prefix EXPO_PUBLIC_ mới expose vào bundle.
# App này KHÔNG dùng Expo Go, build native nên `localhost` chỉ chạy được
# trên emulator + adb reverse. Trên thiết bị thật phải dùng IP LAN của
# máy dev (ví dụ 192.168.x.x) hoặc domain public khi deploy.
# Sao chép file này sang `.env` và sửa lại theo môi trường.
# ---------------------------------------------------------------------

# URL HTTP của backend (NestJS). LUÔN có `/` ở cuối — code ghép với path
# không có `/` ở đầu để tránh `//`.
#   - Android emulator: http://10.0.2.2:3001/
#   - iOS simulator:    http://localhost:3001/
#   - Thiết bị thật:    http://<IP-LAN-máy-dev>:3001/
#   - Production:       https://api.example.com/
EXPO_PUBLIC_API_URL=http://localhost:3001/

# URL MQTT over WebSocket (Mosquitto port 9001). KHÔNG có `/` ở cuối.
# Local dev:   ws://<IP-LAN-máy-dev>:9001
# Production:  wss://mqtt.example.com
EXPO_PUBLIC_MQTT_URL=ws://localhost:9001
