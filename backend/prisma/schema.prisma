generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

model manager_accounts {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  display_name  String?
  phone_number  String?
  pairing_code  String   @unique
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  devices            devices[]
  sos_events         sos_events[]
}

model devices {
  id                 String     @id @default(uuid())
  manager_account_id String
  owner_name         String
  phone_number       String?
  model              String?
  type               String?
  device_os          String?
  is_locked          Boolean    @default(false)
  last_seen          DateTime?
  last_battery       Int?
  is_offline_alerted Boolean    @default(false)
  is_low_battery_alerted Boolean @default(false)
  registered_at      DateTime   @default(now())

  manager_account manager_accounts @relation(fields: [manager_account_id], references: [id], onDelete: Cascade)

  location_history   location_history[]
  cell_tower_history cell_tower_history[]
  commands           device_commands[]
  device_geofences   device_geofences[]
  sos_events         sos_events[]

  @@index([manager_account_id])
}

model geofences {
  id                 String   @id @default(uuid())
  manager_account_id String
  name               String
  lat                Decimal  @db.Decimal(10, 8)
  lon                Decimal  @db.Decimal(11, 8)
  radius_m           Int
  created_at         DateTime @default(now())
  updated_at         DateTime @default(now()) @updatedAt

  device_geofences device_geofences[]

  @@index([manager_account_id])
}

model device_geofences {
  device_id   String
  geofence_id String
  assigned_at DateTime @default(now())

  device   devices   @relation(fields: [device_id], references: [id], onDelete: Cascade)
  geofence geofences @relation(fields: [geofence_id], references: [id], onDelete: Cascade)

  @@id([device_id, geofence_id])
  @@index([device_id])
  @@index([geofence_id])
}

model device_commands {
  id           String    @id @default(uuid())
  device_id    String
  command      String
  payload      Json?
  status       String    @default("pending")
  error        String?
  created_at   DateTime  @default(now())
  delivered_at DateTime?
  executed_at  DateTime?

  device devices @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id, status])
  @@index([created_at])
}

model location_history {
  id        String  @id @default(uuid())
  device_id String

  latitude  Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)

  accuracy_m Float?

  // Quality tier derived from accuracy_m on ingest. Consumers (polyline,
  // geofence) filter by this; persisted rather than re-derived so tier
  // boundaries can change without rewriting history.
  //   'gps'     ≤ 20m   feed polyline + geofence
  //   'approx'  ≤ 80m   keep for context, skip polyline by default
  //   'network' ≤ 200m  heartbeat only
  quality String? @db.VarChar(16)

  geom Unsupported("geometry(Point,4326)")?

  recorded_at DateTime

  device devices @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id, recorded_at])
  @@index([device_id, quality, recorded_at])
}

model cell_tower_history {
  id        String @id @default(uuid())
  device_id String

  mcc Int?
  mnc Int?
  lac Int?
  cid Int?

  pci        Int?
  type       String?
  is_serving Boolean @default(false)

  rssi       Int?
  signal_dbm Int?

  recorded_at DateTime

  device devices @relation(fields: [device_id], references: [id], onDelete: Cascade)

  @@index([device_id, recorded_at])
}

model bts_stations {
  id      Int     @id @default(autoincrement())
  mcc     Int
  mnc     Int
  lac     Int
  cid     Int
  lat     Decimal @db.Decimal(10, 8)
  lon     Decimal @db.Decimal(11, 8)
  geom    Unsupported("geometry(Point,4326)")?
  radio   String?
  range   Int?
  address String?
  created_at DateTime @default(now()) @db.Timestamp(3)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(3)

  @@unique([mcc, mnc, lac, cid])
  @@index([mcc, mnc, lac, cid])
}

model sos_events {
  id                 String   @id @default(uuid())
  device_id          String
  manager_account_id String
  lat                Decimal  @db.Decimal(10, 8)
  lon                Decimal  @db.Decimal(11, 8)
  accuracy_m         Float?
  battery_level      Int?
  triggered_at       DateTime @default(now())
  acknowledged_at    DateTime?

  device          devices          @relation(fields: [device_id], references: [id], onDelete: Cascade)
  manager_account manager_accounts @relation(fields: [manager_account_id], references: [id], onDelete: Cascade)

  @@index([manager_account_id, triggered_at])
  @@index([device_id, triggered_at])
}

