# --- Postgres (Prisma) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# --- HTTP ---
PORT=3001

# --- Redis (BTS map cache) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MQTT broker (Mosquitto) ---
# Subscribes topic: device/+/telemetry (QoS 1)
MQTT_BROKER_URL=mqtt://localhost:1883

# --- External APIs (tuỳ chọn, thiếu key thì backend skip gracefully) ---
# Reverse geocoding cho location_history.district
LOCATIONIQ_KEY=
# Tra cứu toạ độ BTS theo (mcc,mnc,lac,cid) qua UnwiredLabs / OpenCellID
OPENCELLID_API_KEY=
