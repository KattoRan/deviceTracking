# =====================================================================
# Backend (NestJS) — biến môi trường
# =====================================================================
# Sao chép sang `.env`, sửa giá trị, rồi `npm run start:dev`.
# Khi deploy (Railway, Docker, …) khai báo các biến tương ứng ở provider.
# ---------------------------------------------------------------------

# --- HTTP server ---
PORT=3001

# --- Postgres / TimescaleDB ---
# Dùng cho cả Prisma (DATABASE_URL) và docker-compose (POSTGRES_*).
# Nếu chạy DB managed (Railway, Supabase …) chỉ cần DATABASE_URL.
POSTGRES_USER=deviceTrack
POSTGRES_PASSWORD=changeme
POSTGRES_DB=deviceTrack
DATABASE_URL=postgresql://deviceTrack:changeme@localhost:5432/deviceTrack?schema=public

# --- Admin auth (JWT) ---
# Đổi sang chuỗi ngẫu nhiên đủ dài trước khi deploy.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# --- Redis (BTS map cache) ---
# Có 2 cách khai: REDIS_URL (ưu tiên) HOẶC REDIS_HOST + REDIS_PORT.
# REDIS_URL=redis://default:password@host:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# --- MQTT broker (Mosquitto) ---
# Backend subscribe topic: device/+/telemetry (QoS 1).
# Local: mqtt://localhost:1883
# Production (TLS): mqtts://mqtt.example.com:8883
MQTT_BROKER_URL=mqtt://localhost:1883

# --- External APIs (tuỳ chọn — thiếu key thì backend skip gracefully) ---
# Reverse geocoding cho location_history.district.
LOCATIONIQ_KEY=
# Tra cứu toạ độ BTS theo (mcc,mnc,lac,cid) qua UnwiredLabs / OpenCellID.
OPENCELLID_API_KEY=
